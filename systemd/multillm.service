[Unit]
Description=MultiLLM OpenAI-compatible LLM gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/walter/github/MultiLLM
ExecStart=/usr/bin/java -jar /home/walter/github/MultiLLM/target/MultiLLM-1.0.0-jar-with-dependencies.jar 8085
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
